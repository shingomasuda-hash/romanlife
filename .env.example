# =============================================================
# ロマンライフ オープン・カンパニー LP ／ 環境変数サンプル
#
#   cp .env.example .env.local
#
# ・秘密鍵・送信先はソースコードへ直接記載しないでください。
# ・NEXT_PUBLIC_ で始まる変数だけがブラウザへ露出します。
#   それ以外はサーバー側でのみ参照されます。
# =============================================================

# -------------------------------------------------------------
# サイト
# -------------------------------------------------------------
# 本番の公開URL。OGP・canonical・構造化データのURLに使用します。
NEXT_PUBLIC_SITE_URL=

# 個人情報の取り扱いについて（プライバシーポリシー）のURL。
# ★未設定の間は、申込フォームの同意欄がリンクにならず、
#   「未設定」であることが画面に表示されます。公開前に必ず設定してください。
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# 申込完了画面に表示する問い合わせ先メールアドレス。
# 未設定の場合、完了画面に問い合わせ先は表示されません（架空の連絡先は表示しません）。
NEXT_PUBLIC_CONTACT_EMAIL=

# -------------------------------------------------------------
# 申込データの保存先
#   ENTRY_WEBHOOK_URL と ENTRIES_FILE の少なくとも一方が必要です。
#   どちらにも保存できなかった場合、利用者へ「成功」は返さずエラーになります。
# -------------------------------------------------------------
# 任意の受け口へ POST します（Google Apps Script / Googleスプレッドシート連携 /
# 採用管理システム / Zapier / 自社APIなど）。本番はこちらを推奨します。
#
# スプレッドシートへ自動追記する場合は
# tools/google-apps-script/entries-to-spreadsheet.gs をデプロイし、
# 発行されたURLに ?token=（合言葉）を付けたものを設定してください。
#   例: https://script.google.com/macros/s/AKfy.../exec?token=xxxxxxxx
ENTRY_WEBHOOK_URL=

# ★ 予備の受け口（任意）。設定すると、上の受け口と同時に同じ内容を送ります。
#
# 別のGoogleアカウントで作った別のスプレッドシートを指定してください。
# 片方が止まっても、もう片方に申込みが残ります。
# 両方に届かなかった場合だけエラーとして扱い、申込者に再送信を促します。
#
# 同じアカウント・同じスプレッドシートを指定しても控えにはなりません。
# 必ず別アカウントで用意してください。
ENTRY_WEBHOOK_URL_BACKUP=

# Webhook 側で送信元を検証する場合の共有シークレット（Authorization: Bearer で送信）
# ※ Google Apps Script は Authorization ヘッダーを受け取れないため、
#   GASを使う場合はこの変数ではなく、上のURLの ?token= で検証してください。
ENTRY_WEBHOOK_SECRET=

# JSONL ファイルへの追記先（既定：./data/entries.jsonl）。
# Vercel などファイルシステムが読み取り専用の環境では一時領域へ退避されるため、
# 恒久的な保存先としては ENTRY_WEBHOOK_URL を使用してください。
ENTRIES_FILE=

# データベースへ保存する場合の接続情報（src/lib/server/storage.ts に adapter を追加してください）
DATABASE_URL=

# -------------------------------------------------------------
# メール通知（未設定の場合は送信しません）
#   既定では Resend の HTTP API を使用します（追加パッケージ不要）。
#   他のメール基盤を使う場合は src/lib/server/notify.ts の sendMail を差し替えてください。
# -------------------------------------------------------------
RESEND_API_KEY=

# 送信元アドレス（RESEND_API_KEY とセットで必須）
ENTRY_FROM_EMAIL=

# 申込内容の転送先。カンマ区切りで複数指定できます。
# ★ここに設定したアドレスへ、フォームに入力された内容がそのまま届きます。
ENTRY_NOTIFICATION_EMAIL=saiyo@romanlife.co.jp,shingo.masuda@any-ware.jp

# 申込者からの返信先（Reply-To）
ENTRY_REPLY_TO_EMAIL=

# 申込者への自動返信を有効にする場合のみ true を設定します。
# ★true にしない限り、完了画面に「受付完了メールをお送りしました」とは表示されません。
ENTRY_AUTOREPLY_ENABLED=false
